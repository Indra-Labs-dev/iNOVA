# iNOVA backend — copy to .env and adjust. Never commit the real .env file
# (see docs/12-security/secrets.md). All values below are placeholders.

ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Database — see docker-compose.yml (host port 5434 to avoid local conflicts)
DATABASE_URL=postgresql+psycopg2://inova:inova_dev_password@localhost:5434/inova

# Auth — see docs/adr/0010-authentication-approach.md. Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_DO_NOT_USE_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI / Ollama — see docs/06-ai/ollama.md
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_REQUEST_TIMEOUT_SECONDS=60
